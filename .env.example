# BBDRTS Backend Environment Configuration
PORT=3001
JWT_SECRET=your_jwt_secret_key_here

# Cloud MySQL Database Configuration (Required for Render to prevent data loss)
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_USER=your_tidb_user
# DB_PASSWORD=your_tidb_password
# DB_PORT=4000
# DB_NAME=test

# Ethereum Sepolia EVM Configuration
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Real Gmail SMTP Configuration (App Password)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Philippine Cellular SMS Gateway (Semaphore)
SEMAPHORE_API_KEY=your_semaphore_api_key

# Android Phone Personal SMS Gateway (TextBee)
TEXTBEE_API_KEY=your_textbee_api_key
TEXTBEE_DEVICE_ID=your_textbee_device_id
